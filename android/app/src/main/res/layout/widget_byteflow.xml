<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Top Bar: Carrier and SIM Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_carrier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_default_carrier"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_sim_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIM 1"
            android:textColor="@color/widget_accent_blue"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="ByteFlow"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Metric: Mobile Data Today -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_mobile_used"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_mobile_default"
            android:textColor="@color/widget_on_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sublabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile Data Today"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar" />
    </LinearLayout>

    <!-- Bottom Row: Wi-Fi usage and Plan quota status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_wifi_used"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wi-Fi: 0 MB"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_quota_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_quota_default"
            android:textColor="@color/widget_accent_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
