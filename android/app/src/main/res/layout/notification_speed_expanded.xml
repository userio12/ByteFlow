<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:background="@android:color/transparent"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Speed Indicator (Numeric Speed on top, Unit below) -->
    <LinearLayout
        android:id="@+id/notif_expanded_speed_indicator"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="top"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/notif_expanded_speed_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/oneui_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center" />

        <TextView
            android:id="@+id/notif_expanded_speed_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KB/s"
            android:textColor="@color/oneui_unit_blue"
            android:textSize="9.5sp"
            android:includeFontPadding="false"
            android:gravity="center" />
    </LinearLayout>

    <!-- Main Content: Header App Title + Chevron, Speeds, and Traffic Stats -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Top/Header: App Identity + Expand/Collapse Affordance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_expanded_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/speed_notification_title"
                android:textColor="@color/oneui_text_primary"
                android:textSize="13.5sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/notif_expanded_chevron"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_notif_chevron_up"
                android:tint="@color/oneui_chevron"
                android:contentDescription="Collapse" />
        </LinearLayout>

        <!-- Speeds Row: Down: ... Up: ... -->
        <TextView
            android:id="@+id/notif_expanded_line_speeds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Down: 0 B/s   Up: 0 B/s"
            android:textColor="@color/oneui_text_primary"
            android:textSize="13.5sp"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Traffic Stats Row: Mobile: ... WiFi: ... -->
        <TextView
            android:id="@+id/notif_expanded_line_traffic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Mobile: 910.4 MB   WiFi: 0 MB"
            android:textColor="@color/oneui_text_secondary"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:singleLine="true" />
    </LinearLayout>

</LinearLayout>
