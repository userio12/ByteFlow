<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/notification_card_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Speed Indicator (Numeric Speed on top, Unit below) -->
    <LinearLayout
        android:id="@+id/notif_expanded_speed_indicator"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/notif_expanded_speed_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/oneui_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center" />

        <TextView
            android:id="@+id/notif_expanded_speed_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KB/s"
            android:textColor="@color/oneui_text_secondary"
            android:textSize="9.5sp"
            android:includeFontPadding="false"
            android:gravity="center" />
    </LinearLayout>

    <!-- Main Content: Header App Title, Speeds, and Traffic Stats -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <!-- Top/Header: App Identity -->
        <TextView
            android:id="@+id/notif_expanded_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_notification_title"
            android:textColor="@color/oneui_text_primary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Speeds Row: Down: ... Up: ... -->
        <TextView
            android:id="@+id/notif_expanded_line_speeds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Down: 0 KB/s   Up: 0 B/s"
            android:textColor="@color/oneui_text_primary"
            android:textSize="13.5sp"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Traffic Stats Row: Mobile: ... WiFi: ... -->
        <TextView
            android:id="@+id/notif_expanded_line_traffic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Mobile: 0 B   WiFi: 0 B"
            android:textColor="@color/oneui_text_secondary"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Subtle Samsung-Style Collapse Chevron -->
    <ImageView
        android:id="@+id/notif_expanded_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top"
        android:layout_marginTop="2dp"
        android:src="@drawable/ic_notif_chevron_up"
        android:tint="@color/oneui_chevron"
        android:contentDescription="Collapse" />

</LinearLayout>
