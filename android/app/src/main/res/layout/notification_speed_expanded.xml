<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notification_card_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- App Title Header: ByteFlow -->
    <TextView
        android:id="@+id/notif_expanded_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/speed_notification_title"
        android:textColor="@color/notif_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <!-- Dual Metric Cards Row (DOWN and UP) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">

        <!-- Download Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/notification_badge_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOWN"
                android:textColor="@color/notif_download"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/notif_expanded_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 B/s"
                android:textColor="@color/notif_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Spacer -->
        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Upload Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/notification_badge_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UP"
                android:textColor="@color/notif_upload"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/notif_expanded_upload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 B/s"
                android:textColor="@color/notif_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtitle: Mobile and Wi-Fi Traffic Stats -->
    <TextView
        android:id="@+id/notif_expanded_traffic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginStart="2dp"
        android:text="Mobile: 0 B  •  Wi-Fi: 0 B"
        android:textColor="@color/notif_text_secondary"
        android:textSize="11.5sp"
        android:includeFontPadding="false"
        android:singleLine="true" />

</LinearLayout>
