<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <!-- Row 1: Network Connection Status (No redundant ByteFlow title) -->
    <TextView
        android:id="@+id/notif_expanded_network"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wi-Fi • Connected"
        android:textColor="@color/notif_text_secondary"
        android:textSize="11.5sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <!-- Row 2: Real-time Speeds -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Down: "
            android:textColor="@color/notif_download"
            android:textSize="14sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/notif_expanded_download"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 B/s"
            android:textColor="@color/notif_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" />

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Up: "
            android:textColor="@color/notif_upload"
            android:textSize="14sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/notif_expanded_upload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 B/s"
            android:textColor="@color/notif_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Row 3: Today's Traffic Stats -->
    <TextView
        android:id="@+id/notif_expanded_traffic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Today: 0 B Mobile  •  0 B Wi-Fi"
        android:textColor="@color/notif_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <!-- Row 4: Quota / Data Plan Status -->
    <TextView
        android:id="@+id/notif_expanded_quota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Data Plan: Active"
        android:textColor="@color/notif_text_secondary"
        android:textSize="11.5sp"
        android:includeFontPadding="false"
        android:singleLine="true" />

</LinearLayout>
